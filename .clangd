CompileFlags:
  CompilationDatabase: build

Index:
  Background: Build

Diagnostics:
  ClangTidy: 
    Add: 
      - "modernize-*"
      - "performance-*"
      - "readability-*"
    Remove:
      - "readability-braces-around-statements"

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true